{
  "name": "@socialcaredata/validator",
  "version": "0.1.0",
  "private": true,
  "description": "Validate social care data against the published Social Care MAIS SHACL shapes in the browser. Built on @theodi/data-standard-validator.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SocialCareData/validator.git"
  },
  "homepage": "https://socialcaredata.github.io/validator/",
  "bugs": {
    "url": "https://github.com/SocialCareData/validator/issues"
  },
  "sideEffects": [
    "./web/src/worker-globals.ts"
  ],
  "scripts": {
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run --exclude '**/web.test.ts' --exclude '**/node_modules/**'",
    "test:web": "vitest run test/web.test.ts",
    "test:conformance": "vitest run test/conformance.test.ts",
    "expectations": "vite-node scripts/update-expectations.ts"
  },
  "dependencies": {
    "@theodi/data-standard-validator": "file:../data-standard-validator"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.55.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-node": "^2.1.8",
    "vitest": "^2.1.8"
  }
}
